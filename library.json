  "keywords": "tuf2000, tuf-2000, flow meter, ultrasonic, modbus, rs485, esp32, emodbus",
  "repository": {
    "type": "git",
    "url": "https://github.com/igrowing/tuf2000.git"
  },
  "authors": [
    {
      "name": "iGrowing",
      "email": "support.plaything728@silomails.com"
    }
  ],
  "license": "MIT",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "dependencies": [
    {
      "name": "eModbus",
      "version": "https://github.com/eModbus/eModbus.git#v1.7.4.stable"
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "library.json",
      "library.properties",
      "README.md",
      "LICENSE",
      "CHANGELOG.md"
    ]
  }
